# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=sqlite+aiosqlite:///./wa_assistant.db

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WA_MASTER_KEY=

# Meta WhatsApp Cloud API (from your Meta App dashboard)
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-string-yourself

# M-Pesa (Daraja) - sandbox by default, switch base URL for production
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# The public URL where this app is reachable (used to build M-Pesa callback
# URLs). Must match your actual deployment domain.
APP_BASE_URL=https://your-domain.example.com
# A random string YOU choose, embedded in the callback URL path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MPESA_CALLBACK_SECRET=

# LLM
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
GEMINI_API_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=development
